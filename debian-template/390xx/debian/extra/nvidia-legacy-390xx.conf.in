# modprobe options for the NVIDIA @VERSION@ (@SERIES@) driver.
# Rename target: nvidia-legacy-@SERIES@.conf
alias char-major-195* nvidia
alias nvidia-current nvidia
options nvidia NVreg_DeviceFileMode=0660 NVreg_DeviceFileGID=44
# nvidia-drm modeset=1: KMS is stable on this series (Kepler+) and required
# for Wayland/GBM. Override in a higher-priority modprobe.d file to disable.
options nvidia-drm modeset=1
softdep nvidia post: nvidia-modeset nvidia-uvm
