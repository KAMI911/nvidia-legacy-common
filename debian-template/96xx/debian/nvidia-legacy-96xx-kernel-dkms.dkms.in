PACKAGE_NAME="@DKMS_NAME@"
PACKAGE_VERSION="@DKMS_VERSION@"
AUTOINSTALL="yes"

# IGNORE_PREEMPT_RT_PRESENCE=1: build on PREEMPT_RT kernels too — upstream's
# conftest otherwise bails on RT. RT is best-effort (non-blocking in CI).
%if flat_module
# Flat legacy layout (@VERSION@): kernel/Makefile builds a single nvidia.ko via
# the singular `module` target.
MAKE[0]="'make' -j$(nproc) IGNORE_PREEMPT_RT_PRESENCE=1 module SYSSRC=${kernel_source_dir} KERNEL_UNAME=${kernelver}"
CLEAN="'make' KERNEL_UNAME=${kernelver} clean"

BUILT_MODULE_NAME[0]="nvidia"
BUILT_MODULE_LOCATION[0]="."
DEST_MODULE_LOCATION[0]="/updates/dkms"
%if module_uvm
MAKE[0]+="; make -C uvm module SYSSRC=${kernel_source_dir} KERNEL_UNAME=${kernelver} KBUILD_EXTMOD=${dkms_tree}/@DKMS_NAME@/@DKMS_VERSION@/build/uvm"
CLEAN="${CLEAN}; make -C uvm KERNEL_UNAME=${kernelver} clean"
BUILT_MODULE_NAME[1]="nvidia-uvm"
BUILT_MODULE_LOCATION[1]="uvm"
DEST_MODULE_LOCATION[1]="/updates/dkms"
%endif
%else
# Modular layout (@VERSION@): kernel/Makefile has a `modules` target building
# nvidia, nvidia-modeset, nvidia-drm and nvidia-uvm.
MAKE[0]="'make' -j$(nproc) IGNORE_PREEMPT_RT_PRESENCE=1 NV_EXCLUDE_BUILD_MODULES='' KERNEL_UNAME=${kernelver} modules"
CLEAN="'make' -j$(nproc) KERNEL_UNAME=${kernelver} clean"

BUILT_MODULE_NAME[0]="nvidia"
BUILT_MODULE_LOCATION[0]="."
DEST_MODULE_LOCATION[0]="/updates/dkms"

BUILT_MODULE_NAME[1]="nvidia-modeset"
BUILT_MODULE_LOCATION[1]="."
DEST_MODULE_LOCATION[1]="/updates/dkms"

BUILT_MODULE_NAME[2]="nvidia-drm"
BUILT_MODULE_LOCATION[2]="."
DEST_MODULE_LOCATION[2]="/updates/dkms"

BUILT_MODULE_NAME[3]="nvidia-uvm"
BUILT_MODULE_LOCATION[3]="."
DEST_MODULE_LOCATION[3]="/updates/dkms"
%endif

# Skip modules that a given kernel/arch cannot build instead of failing the
# whole DKMS build.
BUILD_EXCLUSIVE_KERNEL_MIN="3.10"
